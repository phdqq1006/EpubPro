<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/tts_audio_widget_background">

    <ImageView
        android:id="@+id/tts_widget_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:src="@android:drawable/ic_lock_silent_mode_off"
        android:tint="@color/tts_widget_primary"
        android:contentDescription="@string/tts_widget_icon_description" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tts_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/tts_widget_on_surface"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tts_widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/tts_widget_on_surface_variant"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/tts_widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressTint="@color/tts_widget_primary"
            android:indeterminateTint="@color/tts_widget_primary" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/tts_widget_previous"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_previous"
        android:tint="@color/tts_widget_on_surface"
        android:contentDescription="@string/tts_widget_previous" />

    <ImageButton
        android:id="@+id/tts_widget_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_play"
        android:tint="@color/tts_widget_primary"
        android:contentDescription="@string/tts_widget_play_pause" />

    <ImageButton
        android:id="@+id/tts_widget_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_next"
        android:tint="@color/tts_widget_on_surface"
        android:contentDescription="@string/tts_widget_next" />
</LinearLayout>
